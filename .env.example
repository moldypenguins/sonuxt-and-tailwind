# Node Environment [ local, development, production ]
NODE_ENV=development

# Nuxt Public
## Site
NUXT_PUBLIC_SITE_URL=https://dev.domain.com:8443 # Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_NAME=Sonuxt & Tailwind
NUXT_PUBLIC_SITE_DESCRIPTION=A NuxtUI and TailwindCSS Starter Template.
## GSuite
NUXT_PUBLIC_GSUITE_RECAPTCHA_KEY=
NUXT_PUBLIC_GSUITE_ANALYTICS_KEY=
NUXT_PUBLIC_GSUITE_ADWORDS_KEY=

# Nuxt Private
## Telemetry
NUXT_TELEMETRY_DISABLED=1
## Session
NUXT_SESSION_NAME=sonuxt-and-tailwind-session
NUXT_SESSION_PASSWORD=71228f2d76105ed5fa0b53ac3a24a89b
## GSuite
NUXT_GSUITE_RECAPTCHA_SECRET=
NUXT_GSUITE_ANALYTICS_SECRET=
NUXT_GSUITE_ADWORDS_SECRET=
## AI
## https://ai-sdk.dev/providers/ai-sdk-providers/google-generative-ai#provider-instance
## https://aistudio.google.com/api-keys
## https://ai-sdk.dev/cookbook/node/mcp-tools
## https://github.com/mcp/io.github.github/github-mcp-server
GOOGLE_GENERATIVE_AI_API_KEY=


# Theme Properties
## Light
NUXT_THEME_LIGHT_PRIMARY=purple
NUXT_THEME_LIGHT_SECONDARY=slate
NUXT_THEME_LIGHT_TERTIARY=silver
NUXT_THEME_LIGHT_EMPHASIS=orange
NUXT_THEME_LIGHT_SUCCESS=green
NUXT_THEME_LIGHT_INFO=blue
NUXT_THEME_LIGHT_WARNING=amber
NUXT_THEME_LIGHT_ERROR=red
NUXT_THEME_LIGHT_NEUTRAL=slate
## Dark
NUXT_THEME_DARK_PRIMARY=purple
NUXT_THEME_DARK_SECONDARY=slate
NUXT_THEME_DARK_TERTIARY=silver
NUXT_THEME_DARK_EMPHASIS=orange
NUXT_THEME_DARK_SUCCESS=green
NUXT_THEME_DARK_INFO=blue
NUXT_THEME_DARK_WARNING=amber
NUXT_THEME_DARK_ERROR=red
NUXT_THEME_DARK_LIGHT=white
NUXT_THEME_DARK_DARK=black
NUXT_THEME_DARK_NEUTRAL=slate
